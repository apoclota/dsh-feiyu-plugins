{
  "name": "dsh-town-life",
  "version": "1.0.4",
  "description": "橡溪镇生活线：给小渊一座可生活的 2D 小镇，带实时地图网页、店铺内景、货币与 NPC，以及小屋自由装修和设置页面板。",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "lib", "cordis.patch.yml", "locale", "docs", "icon.svg", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": ["slots"], "external": ["react"] }
  },
  "engines": { "node": ">=22", "dsh": ">=0.2.1-rc.2" },
  "scripts": { "town": "node lib/serve.mjs" }
}
